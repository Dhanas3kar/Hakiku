# HAKIKU Production Environment Configuration Contract

# --- Core Server & Database ---
# REQUIRED: PostgreSQL Database Connection String
DATABASE_URL=postgres://user:password@localhost:5432/srm_connect

# REQUIRED: Redis Connection String
REDIS_URL=redis://localhost:6379

# OPTIONAL: Key prefix for Redis keys (default: dev: or test:)
REDIS_PREFIX=prod:

# OPTIONAL: API HTTP Server Listen Port (default: 3001)
PORT=3001

# --- Authentication & Security Credentials ---
# REQUIRED: Secret key for signing session cookies (Minimum 32 random characters)
COOKIE_SECRET=change-this-to-a-secure-random-32-char-cookie-secret

# REQUIRED: Secret key for signing JWT tokens (Minimum 32 random characters)
JWT_SECRET=change-this-to-a-secure-random-32-char-jwt-secret

# REQUIRED: Expected JWT Issuer string
JWT_ISSUER=hakiku-api

# REQUIRED: Expected JWT Audience string
JWT_AUDIENCE=hakiku-app

# REQUIRED: Secret key for OTP signing/hashing
OTP_SECRET=change-this-to-a-secure-random-32-char-otp-secret

# --- CORS & Networking ---
# OPTIONAL: Allowed origins for CORS requests (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://hakiku.app

# OPTIONAL: Primary frontend application URL
FRONTEND_URL=http://localhost:3000

# --- Health & Telemetry Thresholds ---
# OPTIONAL: Health check probe execution timeout in milliseconds (default: 3000)
HEALTH_CHECK_TIMEOUT_MS=3000

# OPTIONAL: Liveness event loop lag threshold in milliseconds (default: 2000)
HEALTH_LIVENESS_EVENT_LOOP_THRESHOLD_MS=2000

# OPTIONAL: Outbox pending backlog alert threshold (default: 10000)
HEALTH_OUTBOX_BACKLOG_THRESHOLD=10000

# --- Background Worker Control ---
# OPTIONAL: Set to 'false' to disable message delivery worker auto-polling
MESSAGE_WORKER_ENABLED=true

# OPTIONAL: Set to 'false' to disable notification worker auto-polling
NOTIFICATION_WORKER_ENABLED=true
